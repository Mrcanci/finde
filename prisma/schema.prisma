// Finde — Prisma schema
// Postgres (Supabase) + pgvector + pg_trgm

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp")]
}

// ---------- Enums ----------

enum Category {
  adventure
  cultural
  gastronomy
  nature
  mystic
}

enum CancellationPolicy {
  Flexible
  Moderada
  Estricta
  NoReembolsable
}

// Modo de venta del tour (diseño inventario 2026-08):
// CUPO_FIJO  = allotment exclusivo Finde, confirmación instantánea, cierra al llenarse.
// SOLICITUD  = sin límite de asientos; las reservas nacen como solicitudes y la
//              agencia confirma en lote antes del cierre (closeTime/closeDaysBefore).
enum SalesMode {
  CUPO_FIJO
  SOLICITUD
}

// Ciclo de vida de la reserva. En CUPO_FIJO nace CONFIRMADA; en SOLICITUD nace
// SOLICITUD y vence (VENCIDA) a las 72h o al cierre de su salida, lo que llegue
// primero (vencimiento perezoso: se evalúa al leer, se persiste al tocar;
// pg_cron de Supabase es el upgrade futuro para avisos automáticos).
enum BookingStatus {
  SOLICITUD
  CONFIRMADA
  RECHAZADA
  VENCIDA
  CANCELADA
}

// Estado de una salida materializada. "Llena" NO es un estado: es derivado
// (seatsTaken >= cupo efectivo), sin nada extra que sincronizar.
enum DepartureStatus {
  ABIERTA
  CONFIRMADA
  CANCELADA
}

// ---------- Models ----------

model Operator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  verified  Boolean  @default(false)
  city      String?
  createdAt DateTime @default(now())

  // M1 sub-paso 8: vínculo con Supabase auth.users (nullable: operadores
  // del seed quedan sin dueño). FK lógica, no la maneja Prisma.
  userId    String?  @unique
  // RUC del operador (persistido desde el onboarding; antes solo se validaba).
  ruc       String?
  // N° de registro MINCETUR enviado por el operador; null = no enviado.
  mincetur  String?

  tours     Tour[]
}

model Tour {
  id            String   @id @default(cuid())
  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  title         String
  description   String   @db.Text
  shortPitch    String?

  titleQu       String?            // traducción quechua del título (null = sin traducir)
  descQu        String?            // traducción quechua de la descripción (null = sin traducir)
  shortPitchQu  String?            // traducción quechua del shortPitch (null = sin traducir)

  category      Category
  difficulty    String?
  city          String
  region        String

  durationHours Int
  priceSoles    Int      // céntimos de sol (ej: 8500 = S/85.00)
  capacity      Int      @default(10)

  language      String[] @default(["es"])
  included      String[] @default([])
  excluded      String[] @default([])
  includedQu    String[] @default([]) // espeja included en quechua (vacío = sin traducir)
  excludedQu    String[] @default([]) // espeja excluded en quechua (vacío = sin traducir)

  imageUrl      String?            // portada (cards/búsqueda/voucher)
  images        String[] @default([]) // galería multi-foto (Opción A); imageUrl es la portada
  rating        Float    @default(0)
  reviewsCount  Int      @default(0)

  aiSummary     String?
  altTour       Json?
  tags          String[]           @default([])
  badge         String?
  cancellation  CancellationPolicy @default(Moderada)
  meetingPoint  String?
  meetingPointQu String?           // traducción quechua del meetingPoint (null = sin traducir)
  altitude      Int?
  startTime     String?            // hora de salida "HH:MM" (24h); null = sin definir (legacy)
  active        Boolean            @default(true) // operador pausa/reanuda; el catálogo público filtra active=true
  days          Boolean[]          @default([true, true, true, true, true, true, true])
  excludedDates String[]           @default([])
  addedDates    String[]           @default([])

  // Inventario (2026-08). days/startTime/excludedDates/addedDates siguen siendo
  // la regla de recurrencia; las salidas se materializan de forma perezosa en
  // Departure ante el primer evento real sobre una fecha.
  salesMode       SalesMode @default(SOLICITUD) // default = comportamiento actual real
  allotment       Int?      // asientos exclusivos Finde por salida (CUPO_FIJO); null en SOLICITUD
  minQuorum       Int?      // "mínimo N personas para salir"; informa progreso, NO ejecuta nada
  closeTime       String?   // "HH:MM" Lima; null = default de producto "20:00"
  closeDaysBefore Int?      // días antes de la salida; null = default 1 (víspera)

  embedding     Unsupported("vector(1024)")?

  createdAt     DateTime @default(now())

  bookings      Booking[]
  departures    Departure[]

  @@index([category])
  @@index([city])
}

// Salida materializada PEREZOSAMENTE: la fila existe solo cuando hubo un evento
// real sobre esa fecha (una reserva, una edición de agencia, una confirmación).
// La disponibilidad general se calcula al vuelo desde la regla de recurrencia
// del Tour; el unique (tourId, date) es la clave del upsert anti-carrera.
model Departure {
  id                String          @id @default(cuid())
  tourId            String
  tour              Tour            @relation(fields: [tourId], references: [id], onDelete: Restrict)
  date              String          // "YYYY-MM-DD" (fecha Lima), misma convención que excludedDates
  startTime         String?         // COPIADA del tour al materializar (pin): editar el tour no mueve salidas vendidas
  status            DepartureStatus @default(ABIERTA)
  allotmentOverride Int?            // cupo efectivo = allotmentOverride ?? tour.allotment
  seatsTaken        Int             @default(0) // guests CONFIRMADOS; solo muta vía update condicional atómico
  seatsRequested    Int             @default(0) // guests en SOLICITUD pendiente (progreso de quórum)
  confirmedAt       DateTime?
  cancelReason      String?
  createdAt         DateTime        @default(now())
  bookings          Booking[]

  @@unique([tourId, date])
  @@index([status, date])
}

model Booking {
  id           String   @id @default(cuid())
  tourId       String
  // Restrict (no Cascade): borrar un tour con reservas debe FALLAR a nivel DB,
  // no evaporar las reservas en silencio. El handler DELETE /api/tours/[id]
  // valida antes y responde 409 invitando a pausar; este FK es la red de
  // seguridad si algo intenta el borrado por otra vía.
  tour         Tour     @relation(fields: [tourId], references: [id], onDelete: Restrict)

  userEmail    String
  userName     String
  userPhone    String?

  // M1 sub-paso 8: vínculo con Supabase auth.users (nullable: bookings
  // previos al auth quedan sin userId). FK lógica, no la maneja Prisma.
  userId       String?

  guests       Int      @default(1)
  totalSoles   Int      // céntimos de sol (ej: 17000 = S/170.00)

  status       String   @default("confirmed")
  bookingCode  String   @unique
  scheduledAt  DateTime

  // Inventario (2026-08). statusNew es TRANSICIONAL: convive con el String
  // `status` hasta la fase de limpieza (DROP + RENAME a `status`), porque
  // convertir el tipo in-place con db push implicaría drop de la columna.
  // expiresAt null = legacy sin vencimiento (las reservas pre-migración no
  // vencen retroactivamente) o reserva ya decidida.
  statusNew    BookingStatus?
  departureId  String?
  departure    Departure? @relation(fields: [departureId], references: [id], onDelete: Restrict)
  expiresAt    DateTime?
  decidedAt    DateTime?

  createdAt    DateTime @default(now())

  @@index([tourId])
  @@index([userEmail])
  @@index([userId])
  @@index([departureId])
  @@index([statusNew, expiresAt]) // barrido perezoso de vencimientos
}

model SearchLog {
  id         String   @id @default(cuid())
  query      String
  resultIds  String[] @default([])
  reasoning  String?  @db.Text
  createdAt  DateTime @default(now())
}

model FeaturedSearch {
  id              String   @id @default(cuid())
  query           String   @unique
  results         String[] @default([])
  reasoning       String   @db.Text
  filtersDetected Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
